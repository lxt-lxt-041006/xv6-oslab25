+// Count how many procs are UNUSED (free slots in proc table)
+uint64 proc_unused_count(void) {
+  uint64 n = 0;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state == UNUSED) n++;
+    release(&p->lock);
+  }
+  return n;
+}
